# Copy to .env (never commit it), then: set -a; source .env; set +a; npm run dist:mac
# Developer ID Application certificate: install it in your login keychain (Xcode > Settings > Accounts),
# electron-builder finds it automatically. Or point to a .p12:
# CSC_LINK=/path/to/DeveloperID_Application.p12
# CSC_KEY_PASSWORD=...

# Notarization, option A: App Store Connect API key (recommended)
# APPLE_API_KEY is the filesystem path to the downloaded .p8 file, not its contents.
APP_BUNDLE_ID=com.uv5r-studio.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Notarization, option B: Apple ID with an app-specific password
APPLE_ID=your-apple-id@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Windows self-signed code-signing certificate.
# For local Windows builds, use the path to the generated .pfx file.
# In GitHub Actions, WIN_CSC_LINK is the base64-encoded .pfx contents.
WIN_CSC_LINK=C:\absolute\path\to\UV5R-Studio-Code-Signing.pfx
WIN_CSC_KEY_PASSWORD=replace-with-a-strong-password
